{
  "database": {
    "rules": "firebase/database.rules.json"
  },
  "hosting": {
    "public": "firebase/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/i/**",
        "destination": "/i/index.html"
      }
    ]
  }
}
