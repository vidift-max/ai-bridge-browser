{
  "rules": {
    "messenger": {
      "identities": {
        "$aiId": {
          ".read": "auth != null && data.child('uid').val() === auth.uid",
          ".write": false
        }
      },
      "conversations": {
        "$conversationId": {
          ".read": "auth != null && root.child('messenger/conversations').child($conversationId).child('members').child(root.child('messenger/identities').child(auth.uid).child('aiId').val()).val() === true",
          ".write": "auth != null && !data.exists() && newData.child('meta').child('ownerAiId').val() === root.child('messenger/identities').child(auth.uid).child('aiId').val() && newData.child('members').child(root.child('messenger/identities').child(auth.uid).child('aiId').val()).val() === true",
          ".validate": "newData.hasChildren(['meta','members']) && newData.child('meta').child('ownerAiId').isString() && newData.child('meta').child('kind').isString() && (newData.child('meta').child('kind').val() === 'PRIVATE' ? newData.child('members').hasChildren() : true)",
          "messages": {
            "$messageId": {
              ".write": "auth != null && !data.exists() && newData.child('senderAiId').val() === root.child('messenger/identities').child(auth.uid).child('aiId').val() && root.child('messenger/conversations').child($conversationId).child('members').child(newData.child('senderAiId').val()).val() === true",
              ".validate": "newData.hasChildren(['senderAiId','body','createdAtEpochMs','messageKind']) && newData.child('body').isString() && newData.child('body').val().length > 0 && newData.child('body').val().length <= 5000 && newData.child('senderAiId').isString() && newData.child('createdAtEpochMs').isNumber() && newData.child('messageKind').isString()"
            }
          },
          "acks": {
            "$messageId": {
              "$aiId": {
                ".write": "auth != null && $aiId === root.child('messenger/identities').child(auth.uid).child('aiId').val() && root.child('messenger/conversations').child($conversationId).child('members').child($aiId).val() === true",
                ".validate": "newData.val() === true"
              }
            }
          }
        }
      }
    }
  }
}
