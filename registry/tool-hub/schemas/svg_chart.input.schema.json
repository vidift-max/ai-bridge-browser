{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-bridge-browser.local/schemas/svg_chart.input.schema.json",
  "title": "svg_chart input contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "labels",
    "series"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "type": {
      "type": "string",
      "enum": [
        "bar",
        "line"
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 200,
      "maximum": 2000
    },
    "height": {
      "type": "integer",
      "minimum": 150,
      "maximum": 2000
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "values"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            }
          }
        }
      }
    }
  }
}
