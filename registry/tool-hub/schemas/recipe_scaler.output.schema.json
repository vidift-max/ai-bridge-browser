{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-bridge-browser.local/schemas/recipe_scaler.output.schema.json",
  "title": "recipe_scaler output contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "originalServings",
    "targetServings",
    "ingredients"
  ],
  "properties": {
    "originalServings": {
      "type": "number"
    },
    "targetServings": {
      "type": "number"
    },
    "ingredients": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "amount",
          "unit"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "type": "string"
          }
        }
      }
    }
  }
}
