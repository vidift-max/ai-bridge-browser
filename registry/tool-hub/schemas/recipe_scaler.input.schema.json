{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-bridge-browser.local/schemas/recipe_scaler.input.schema.json",
  "title": "recipe_scaler input contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ingredients",
    "originalServings",
    "targetServings"
  ],
  "properties": {
    "originalServings": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "targetServings": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "amount",
          "unit"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "amount": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000
          },
          "unit": {
            "type": "string",
            "enum": [
              "g",
              "kg",
              "mg",
              "ml",
              "l",
              "tsp",
              "tbsp",
              "cup",
              "piece",
              "pieces"
            ]
          }
        }
      }
    }
  }
}
