{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-bridge-browser.local/schemas/quiz_engine.output.schema.json",
  "title": "quiz_engine output",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionCount",
        "questions"
      ],
      "properties": {
        "questionCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "prompt",
              "options",
              "explanation"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "text"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  }
                }
              },
              "explanation": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "correct",
        "scorePercent",
        "results"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "correct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "scorePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "questionId",
              "correct",
              "explanation"
            ],
            "properties": {
              "questionId": {
                "type": "string"
              },
              "correct": {
                "type": "boolean"
              },
              "explanation": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}
