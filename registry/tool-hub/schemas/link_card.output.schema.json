{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-bridge-browser.local/schemas/link_card.output.schema.json",
  "title": "link_card output contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "url",
    "title",
    "description",
    "target",
    "rel"
  ],
  "properties": {
    "url": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "target": {
      "const": "_blank"
    },
    "rel": {
      "const": "noopener noreferrer nofollow"
    }
  }
}
