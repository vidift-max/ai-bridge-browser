{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-bridge-browser.local/schemas/tool-invocation.schema.json",
  "title": "AI Tool Bridge Invocation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "toolVersion",
    "input"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "toolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\\\.[0-9]+\\\\.[0-9]+$"
    },
    "input": {
      "type": "object",
      "maxProperties": 64,
      "description": "Validated by the versioned tool-specific input schema and adapter."
    }
  }
}
