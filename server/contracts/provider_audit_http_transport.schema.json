{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provider Audit HTTP Transport Adapter",
  "version": 1,
  "handler": "ProviderAuditAnchorHTTPHandler",
  "serverFactory": "create_provider_audit_anchor_http_server",
  "defaultBindHost": "127.0.0.1",
  "nonLoopbackBinding": "rejected",
  "responseHeaders": {
    "Cache-Control": "no-store",
    "X-Content-Type-Options": "nosniff",
    "Content-Type": "application/json; charset=utf-8"
  },
  "routes": [
    {"method": "GET", "path": "/v1/audit-anchor/latest"},
    {"method": "POST", "path": "/v1/audit-anchor/checkpoints"}
  ],
  "security": {
    "authentication": "delegated to ProviderAuditRemoteService",
    "authorization": "deny by default; explicit callback required",
    "requestLogging": "disabled to avoid credential and checkpoint disclosure",
    "tls": "not provided; production exposure requires separately reviewed TLS deployment adapter"
  }
}